# ==========================================
# Instagram Reel/Post Downloader Configuration
# ==========================================

# Server Port (Local development)
PORT=3000

# Base URL of your deployed application or ngrok tunnel (without trailing slash)
# Examples:
#   Local testing: https://your-ngrok-subdomain.ngrok-free.app
#   Vercel production: https://hqdownloaderbot.vercel.app
BASE_URL=https://hqdownloaderbot.vercel.app

# ==========================================
# Meta / Instagram Messenger API Credentials
# ==========================================
# Get these from Meta for Developers -> App Dashboard -> Instagram Settings
INSTAGRAM_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
INSTAGRAM_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Bot username & Support accounts
BOT_USERNAME=hqdownloaderbot
SUPPORT_ACCOUNT=@jxfr.in
FOLLOW_GATE_ACCOUNT=@jxfr.in

# ==========================================
# Telegram Invisible Headless Cloud Storage
# ==========================================
# Create a Telegram Bot via @BotFather to get the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Create a private Telegram channel, add your bot as Administrator with "Post Messages" permission,
# and get the channel ID (usually starts with -100, e.g. -1001234567890)
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890

# ==========================================
# Database Configuration
# ==========================================
# For Vercel Production: Use a PostgreSQL connection string (e.g. Neon, Supabase, Vercel Postgres)
# Example: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left blank, defaults to local persistent file store for zero-config local development.
DATABASE_URL=
